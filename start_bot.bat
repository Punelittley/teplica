@echo off
chcp 65001 > nul
title Бот уведомлений ВКонтакте - Теплицы ТУТ
echo ========================================================
echo   Запуск бота уведомлений ВКонтакте «Теплицы ТУТ»
echo ========================================================
echo.
cd /d "%~dp0\.."

:loop
echo [%date% %time%] Запуск бота vk_bot.js...
node scripts/vk_bot.js
echo.
echo [ВНИМАНИЕ] Бот завершил работу. Авто-перезапуск через 5 секунд...
timeout /t 5 > nul
goto loop
